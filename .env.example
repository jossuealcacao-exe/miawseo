# Copia este archivo a .env.local y define los valores.

# Token para el panel de moderacion (/admin y /api/admin).
# En desarrollo, si no se define, se usa "dev-moderacion" (NO usar en produccion).
ADMIN_TOKEN=cambia-esto-por-un-token-largo-y-secreto

# Limite de subidas por IP en la ventana de tiempo (opcional).
UPLOAD_RATE_MAX=5
UPLOAD_RATE_WINDOW_MS=600000

# Carpeta de datos persistentes (metadatos + binarios de subidas).
# En produccion apunta al volumen persistente montado (Railway/Render): DATA_DIR=/data
# Si no se define, usa el .data local del proyecto (solo desarrollo).
# DATA_DIR=/data
